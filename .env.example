# Supabase project (Altimeter lives in its own schema `alt`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# scripts only (demo accounts, SIT); never deployed
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_ADMIN_URL=
# app connection: least-privilege login role alt_app through the transaction pooler (port 6543)
ALT_APP_PASSWORD=
DATABASE_URL=postgres://alt_app.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
# worker bearer secret (also stored in Supabase Vault for pg_cron)
ALT_WORKER_SECRET=
ALT_PUBLIC_URL=
# demo accounts; ALT_DEMO_LOGIN=0 hides the one-click roles
ALT_DEMO_PASSWORD=
ALT_DEMO_LOGIN=1
# Gemini via its OpenAI-compatible endpoint, or any in-house OpenAI-compatible model
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
